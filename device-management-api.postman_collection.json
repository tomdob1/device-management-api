{
  "info": {
    "name": "Device Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "List Devices",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/devices/"
      }
    },
    {
      "name": "Get Device",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/devices/1"
      }
    },
    {
      "name": "Create Device",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/devices/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Living Room Lamp\",\n  \"type\": \"light\",\n  \"location\": \"Living Room\"\n}"
        }
      }
    },
    {
      "name": "Update Device",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/devices/1",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Lamp\",\n  \"status\": \"on\"\n}"
        }
      }
    },
    {
      "name": "Delete Device",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/devices/1"
      }
    }
  ]
}
